---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";
import { projects } from "../data/projects";
import { SITE } from "../data/site";

const posts = (await getPosts()).slice(0, 5);
---
<Base>
  <div class="eyebrow">// backend engineer · melbourne</div>
  <h1>Notes on building <b>reliable software</b>.</h1>
  <p class="lede">
    I'm Athira, a software engineer with 12+ years of Java and Spring Boot. I write about concurrency,
    resilience and the details that keep production calm — plus the odd watercolour.
  </p>
  <a class="btn f" href="/blog">Read the blog</a>
  <a class="btn" href="/about">About &amp; resume</a>
  <a class="btn" href="/contact">Get in touch</a>

  <h2>Latest posts</h2>
  <PostList posts={posts} />
  <p><a href="/blog">All posts →</a></p>

  <h2>Projects</h2>
  <p class="sub">Small tools I built for fun.</p>
  <div class="grid">
    {projects.map((p) => (
      <div class="card">
        <h3><a href={p.url} rel="noopener">{p.title}</a></h3>
        <p>{p.description}</p>
        {p.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    ))}
  </div>
</Base>

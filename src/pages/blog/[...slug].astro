---
import { render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import { getPosts, formatDate, readingTime } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, summary, date, tags, cover, coverAlt } = post.data;
---
<Base title={title} description={summary} ogSlug={post.id} type="article" date={date}>
  <ReadingProgress />
  <article data-pagefind-body>
    <div class="eyebrow">{tags.join(" / ") || "blog"}</div>
    <h1 data-pagefind-meta="title">{title}</h1>
    <p class="meta">{formatDate(date)} · {readingTime(post.body)} min read</p>
    {cover && (cover.format === "svg"
      ? <Image class="cover" src={cover} alt={coverAlt} format="svg" />
      : <Image class="cover" src={cover} alt={coverAlt} widths={[480, 720, 1080]} sizes="(max-width: 720px) 100vw, 720px" />)}
    <div class="prose"><Content /></div>
    <p>{tags.map((t) => <a class="tag" href={`/blog/tag/${t}`}>{t}</a>)}</p>
  </article>
  <nav class="pn" aria-label="More posts">
    {older ? <a href={`/blog/${older.id}`}><small>← Older</small>{older.data.title}</a> : <span />}
    {newer ? <a class="next" href={`/blog/${newer.id}`}><small>Newer →</small>{newer.data.title}</a> : <span />}
  </nav>
</Base>

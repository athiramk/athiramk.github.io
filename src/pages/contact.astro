---
import Base from "../layouts/Base.astro";
import { SITE } from "../data/site";
---
<Base title="Contact" description="Get in touch with Athira Kamala – Senior Software Engineer based in Melbourne.">
  <div class="eyebrow">contact</div>
  <h1>Get in <b>touch</b></h1>
  <p class="sub">Have a question or want to work together? Drop me a message, or find me on <a href={SITE.github} rel="noopener">GitHub</a> or <a href={SITE.linkedin} rel="noopener">LinkedIn</a>.</p>

  <form id="contact" action={SITE.formspree} method="POST" novalidate>
    <div class="f-row"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required maxlength="100" aria-describedby="e-name" /><p class="err" id="e-name"></p></div>
    <div class="f-row"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="255" aria-describedby="e-email" /><p class="err" id="e-email"></p></div>
    <div class="f-row"><label for="subject">Subject</label><input id="subject" name="subject" required maxlength="200" aria-describedby="e-subject" /><p class="err" id="e-subject"></p></div>
    <div class="f-row"><label for="message">Message</label><textarea id="message" name="message" rows="6" required maxlength="2000" aria-describedby="e-message"></textarea><p class="err" id="e-message"></p></div>
    <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button class="btn f" type="submit" style="cursor:pointer;font-family:inherit">Send message</button>
    <p class="status" id="status" role="status" aria-live="polite"></p>
  </form>
</Base>
<script>
  const form = document.getElementById("contact") as HTMLFormElement;
  const status = document.getElementById("status")!;
  const rules: Record<string, (v: string) => string> = {
    name: (v) => (v ? "" : "Name is required"),
    email: (v) => (/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v) ? "" : "Please enter a valid email"),
    subject: (v) => (v ? "" : "Subject is required"),
    message: (v) => (v ? "" : "Message is required"),
  };
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    let ok = true;
    for (const [field, check] of Object.entries(rules)) {
      const el = form.elements.namedItem(field) as HTMLInputElement;
      const msg = check(el.value.trim());
      document.getElementById("e-" + field)!.textContent = msg;
      el.setAttribute("aria-invalid", msg ? "true" : "false");
      if (msg) ok = false;
    }
    if (!ok) return;
    status.textContent = "Sending…";
    try {
      const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
      if (res.ok) { form.reset(); status.textContent = "Thanks! Your message is on its way."; }
      else status.textContent = "Something went wrong. Please try again.";
    } catch { status.textContent = "Something went wrong. Please try again."; }
  });
</script>
